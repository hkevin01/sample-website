# Square: public ordering page or Square Online pickup URL.
# Keep payment credentials out of Vite. Secure order creation belongs on a backend.
VITE_SQUARE_PICKUP_URL=https://square.link/u/your-pickup-page

# Shopify: public Storefront API configuration.
# Storefront tokens are designed for browser use; Admin API secrets are not.
VITE_SHOPIFY_SHOP_URL=https://your-shop.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token